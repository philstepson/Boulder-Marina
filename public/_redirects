# Cloudflare Pages redirects
#
# NOTE: every page here builds to a directory (dist/<page>/index.html), and
# Cloudflare Pages already auto-redirects bare paths like /contact to the
# trailing-slash form /contact/ to serve it. Old WordPress links (which used
# trailing slashes, e.g. https://bouldermarina.com/gallery/) therefore already
# land on the correct new page with zero redirects needed. Do NOT add a rule
# that sends the trailing-slash form back to the bare path — that fights
# Cloudflare's own redirect and creates an infinite loop.

# WordPress pages that exist on the old site but have no direct equivalent
/ship-store/              /services                301
/ship-store               /services                301
/carlyle-lake-association/ /                       301
/carlyle-lake-association  /                       301
/links/                   /                        301
/links                    /                        301

# Old blog post
/2021/04/18/hello-world/  /                        301
/2021/04/18/hello-world   /                        301

# WordPress archive / author URLs
/author/admin/            /                        301
/author/admin             /                        301
/category/*               /                        301

# WordPress admin, feeds, and XML-RPC — dead-end gracefully
/wp-admin/*               /                        301
/wp-login.php             /                        301
/xmlrpc.php               /                        301
/feed/                    /                        301
/feed                     /                        301
