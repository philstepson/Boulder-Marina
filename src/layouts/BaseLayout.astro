---
// src/layouts/BaseLayout.astro
// Every page on the site uses this layout.
// SEO meta, LocalBusiness structured data, and global styles are injected here
// automatically — the owner never needs to think about any of this.

import '../styles/global.css';

export interface Props {
  title?:       string;
  description?: string;
  image?:       string;
  type?:        'website' | 'article';
  noIndex?:     boolean;
}

const {
  title       = 'Boulder Marina — Life Unanchored | Carlyle Lake, IL',
  description = 'Full-service marina on the northeastern shore of Carlyle Lake, Illinois. Floating concrete docks, slip rentals, marine services, ship store, and home of Boulder Yacht Club since 1983.',
  image       = '/uploads/marina-og.jpg',
  type        = 'website',
  noIndex     = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// LocalBusiness structured data — boosts Google Maps & search appearance
const structuredData = {
  '@context':  'https://schema.org',
  '@type':     'Marina',
  name:        'Boulder Access Marina',
  alternateName: 'Boulder Marina',
  description: description,
  url:         'https://bouldermarina.com',
  telephone:   '+16182263223',
  email:       'bouldermarina@gmail.com',
  address: {
    '@type':           'PostalAddress',
    streetAddress:     '26000 Boulder Access Rd',
    addressLocality:   'Boulder',
    addressRegion:     'IL',
    postalCode:        '62231',
    addressCountry:    'US',
  },
  geo: {
    '@type':     'GeoCoordinates',
    latitude:    38.5773,
    longitude:  -89.3512,
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Thursday', 'Friday'], opens: '11:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday'], opens: '09:00', closes: '17:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Sunday'],   opens: '09:00', closes: '15:30' },
  ],
  sameAs: [
    'https://www.facebook.com/bouldermarina/',
    'https://boulderyc.org',
  ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noIndex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph (Facebook, iMessage previews) -->
  <meta property="og:type"        content={type} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:image"       content={new URL(image, Astro.site)} />
  <meta property="og:site_name"   content="Boulder Marina" />
  <meta property="og:locale"      content="en_US" />

  <!-- Twitter card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={new URL(image, Astro.site)} />

  <!-- Structured data — automatic, no owner action needed -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/uploads/boulder-marina-logo.png" />

  <!-- Fonts — preconnect for speed, then load -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600&family=DM+Sans:wght@200;300;400;500&display=swap"
    rel="stylesheet"
  />

  <!-- Sitemap — auto-generated by @astrojs/sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />
</head>
<body>
  <slot />
</body>
</html>
