---
// src/layouts/BaseLayout.astro
// Every page on the site uses this layout.
// SEO meta, LocalBusiness structured data, and global styles are injected here
// automatically — the owner never needs to think about any of this.

import '../styles/global.css';

export interface Props {
  title?:       string;
  description?: string;
  image?:       string;
  type?:        'website' | 'article';
  noIndex?:     boolean;
}

const {
  title       = 'Boulder Marina — Life Unanchored | Carlyle Lake, IL',
  description = 'Full-service marina on the northeastern shore of Carlyle Lake, Illinois. Floating concrete docks, slip rentals, marine services, ship store, and home of Boulder Yacht Club since 1983.',
  image       = '/uploads/marina-og.jpg',
  type        = 'website',
  noIndex     = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// LocalBusiness structured data — boosts Google Maps & search appearance
const structuredData = {
  '@context':    'https://schema.org',
  '@type':       ['LocalBusiness', 'SportsActivityLocation'],
  '@id':         'https://www.bouldermarina.com/#localbusiness',
  name:          'Boulder Access Marina',
  alternateName: 'Boulder Marina',
  description:   'Boulder Marina is a full-service marina on Carlyle Lake serving sailboat, motorboat, pontoon, and cruiser owners from Southern Illinois and the greater St. Louis area.',
  url:           'https://www.bouldermarina.com',
  telephone:     '+16182263223',
  email:         'bouldermarina@gmail.com',
  address: {
    '@type':           'PostalAddress',
    streetAddress:     '26000 Boulder Access Rd',
    addressLocality:   'Boulder',
    addressRegion:     'IL',
    postalCode:        '62231',
    addressCountry:    'US',
  },
  geo: {
    '@type':    'GeoCoordinates',
    latitude:    38.5773,
    longitude:  -89.3512,
  },
  areaServed: [
    { '@type': 'Place', name: 'Carlyle Lake' },
    { '@type': 'Place', name: 'Carlyle, Illinois' },
    { '@type': 'Place', name: 'Boulder, Illinois' },
    { '@type': 'Place', name: 'Southern Illinois' },
    { '@type': 'Place', name: 'Greater St. Louis' },
    { '@type': 'Place', name: 'Metro East Illinois' },
  ],
  knowsAbout: [
    'Carlyle Lake marina',
    'boat slips Carlyle Lake',
    'sailboat slips',
    'pontoon slips',
    'motorboat marina',
    'boat storage Carlyle Lake',
    'marina near St. Louis',
    'sailing on Carlyle Lake',
  ],
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Thursday', 'Friday'], opens: '11:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday'], opens: '09:00', closes: '17:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Sunday'],   opens: '09:00', closes: '15:30' },
  ],
  sameAs: [
    'https://www.facebook.com/bouldermarina/',
    'https://boulderyc.org',
  ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- ══ GOOGLE TAG MANAGER ══════════════════════════════════════════════
       Replace GTM-XXXXXXX with the real container ID from tagmanager.google.com
       Also replace GTM-XXXXXXX in the <noscript> tag in <body> below.
  ══════════════════════════════════════════════════════════════════════ -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-XXXXXXX');</script>
  <!-- ══ END GOOGLE TAG MANAGER ══════════════════════════════════════════ -->

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noIndex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph (Facebook, iMessage previews) -->
  <meta property="og:type"        content={type} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:image"       content={new URL(image, Astro.site)} />
  <meta property="og:site_name"   content="Boulder Marina" />
  <meta property="og:locale"      content="en_US" />

  <!-- Twitter card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={new URL(image, Astro.site)} />

  <!-- Structured data — automatic, no owner action needed -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/uploads/boulder-marina-logo.png" />

  <!-- Fonts — preconnect for speed, then load -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600&family=DM+Sans:wght@200;300;400;500&display=swap"
    rel="stylesheet"
  />

  <!-- Sitemap — auto-generated by @astrojs/sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />
</head>
<body>
  <!-- ══ GOOGLE TAG MANAGER (noscript fallback) ═══════════════════════ -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-XXXXXXX"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- ══ END GOOGLE TAG MANAGER ══════════════════════════════════════════ -->

  <slot />
</body>
</html>
