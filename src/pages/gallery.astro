---
// src/pages/gallery.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav        from '../components/Nav.astro';
import Footer     from '../components/Footer.astro';

const albums = [
  {
    slug: 'marina',
    title: 'The Marina',
    year: '2021 – 2025',
    photos: [
      { src: '/uploads/marina-panorama.jpg',        alt: 'Boulder Marina panoramic view from the lake',          caption: 'Carlyle Lake, northeastern shore' },
      { src: '/uploads/gallery/pro-dock-1.jpg',     alt: 'Boulder Marina docks and slips',                      caption: 'Floating concrete docks' },
      { src: '/uploads/gallery/pro-dock-2.jpg',     alt: 'Boulder Marina slip view',                            caption: 'Water and shore power at every slip' },
      { src: '/uploads/gallery/pro-dock-3.jpg',     alt: 'Boulder Marina dock walkway',                         caption: 'The docks at Boulder Marina' },
      { src: '/uploads/gallery/marina-dock-1.jpg',  alt: 'Marina docks on a summer evening',                   caption: 'Summer evening on the docks' },
      { src: '/uploads/gallery/marina-dock-2.jpg',  alt: 'Boats moored at Boulder Marina',                     caption: 'Home port on Carlyle Lake' },
      { src: '/uploads/gallery/marina-aerial.jpeg', alt: 'Aerial view of Boulder Marina',                      caption: 'Boulder Marina from above' },
      { src: '/uploads/gallery/marina-logo-sign.jpg', alt: 'Boulder Marina sign',                              caption: 'Boulder Access Marina' },
    ],
  },
  {
    slug: 'tapas',
    title: 'Tapas on the Docks',
    year: '2021',
    photos: [
      { src: '/uploads/gallery/tapas-1.jpg', alt: 'BYC Tapas on the Docks social event', caption: 'Tapas on the Docks — BYC summer social' },
      { src: '/uploads/gallery/tapas-2.jpg', alt: 'Boaters gathering at Tapas on the Docks', caption: 'The BYC community gathers dockside' },
      { src: '/uploads/gallery/tapas-3.jpg', alt: 'Tapas on the Docks evening at the marina', caption: 'A summer evening on the water' },
      { src: '/uploads/gallery/tapas-4.jpg', alt: 'BYC members at Tapas on the Docks', caption: 'Friends, food, and the lake' },
    ],
  },
  {
    slug: 'events',
    title: 'Club Events',
    year: '2026',
    photos: [
      { src: '/uploads/gallery/spring-thaw.jpg', alt: 'BYC Spring Thaw work day', caption: 'BYC Spring Thaw — getting ready for the season' },
    ],
  },
];
---

<BaseLayout
  title="Boulder Marina Gallery | Carlyle Lake Boats, Docks & Community"
  description="Photos of Boulder Marina on Carlyle Lake — boat slips, sailboats, pontoons, floating docks, and the BYC boating community on Illinois's largest lake."
>
  <Nav />

  <main>

    <!-- ── MASTHEAD ── -->
    <div class="gallery-masthead">
      <img
        src="/uploads/marina-panorama.jpg"
        alt="Boulder Marina on Carlyle Lake"
        width="1024" height="298"
        loading="eager"
        fetchpriority="high"
        class="gallery-masthead-img"
      />
      <div class="gallery-masthead-overlay" aria-hidden="true"></div>
      <div class="gallery-masthead-content container">
        <p class="section-tag">Photos</p>
        <h1>Gallery</h1>
        <p class="masthead-sub">Life on Carlyle Lake — the marina, the docks, and the community.</p>
      </div>
    </div>

    <!-- ── ALBUM FILTER ── -->
    <div class="filter-bar">
      <div class="container filter-inner">
        <button class="filter-btn active" data-album="all">All Photos</button>
        {albums.map(a => (
          <button class="filter-btn" data-album={a.slug}>{a.title}</button>
        ))}
      </div>
    </div>

    <!-- ── ALBUMS ── -->
    <section class="gallery-section">
      <div class="container">

        {albums.map(album => (
          <div class="album-group" data-album={album.slug}>
            <div class="album-header">
              <div>
                <p class="section-tag">{album.year}</p>
                <h2 class="album-title">{album.title}</h2>
              </div>
              <span class="album-count">{album.photos.length} photo{album.photos.length !== 1 ? 's' : ''}</span>
            </div>

            <div class="photo-grid">
              {album.photos.map((photo, i) => (
                <button
                  class="photo-cell"
                  data-src={photo.src}
                  data-alt={photo.alt}
                  data-caption={photo.caption}
                  aria-label={`View: ${photo.caption}`}
                >
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    loading={i < 4 ? 'eager' : 'lazy'}
                    class="photo-img"
                  />
                  <div class="photo-hover">
                    <span class="photo-expand" aria-hidden="true">⊕</span>
                    <span class="photo-caption-text">{photo.caption}</span>
                  </div>
                </button>
              ))}
            </div>
          </div>
        ))}

        <p class="gallery-note">
          More photos coming soon. Have photos from the marina or BYC events?
          <a href="/contact">Send them our way.</a>
        </p>

      </div>
    </section>

    <!-- ── CTA ── -->
    <section class="cta-banner">
      <div class="container cta-inner">
        <div>
          <p class="section-tag">2026 Season</p>
          <h2>Ready to be part of the picture?</h2>
          <p>Slip rates start at $139.50/mo. Day use available at $25 flat. Come see what life on Carlyle Lake looks like.</p>
        </div>
        <div class="cta-buttons">
          <a href="/contact#slip-reservation" class="btn btn--fill">Reserve a Slip</a>
          <a href="/boulder-yacht-club" class="btn">Explore BYC</a>
        </div>
      </div>
    </section>

  </main>

  <!-- ── LIGHTBOX ── -->
  <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <button class="lb-close" id="lb-close" aria-label="Close">✕</button>
    <button class="lb-prev"  id="lb-prev"  aria-label="Previous photo">‹</button>
    <button class="lb-next"  id="lb-next"  aria-label="Next photo">›</button>
    <div class="lb-stage">
      <img id="lb-img" src="" alt="" class="lb-img" />
      <p  id="lb-caption" class="lb-caption"></p>
    </div>
  </div>

  <Footer />
</BaseLayout>

<style>
  /* ── MASTHEAD ── */
  .gallery-masthead { position: relative; width: 100%; line-height: 0; }
  .gallery-masthead-img {
    width: 100%; height: auto; display: block;
    filter: brightness(0.9) saturate(0.85);
  }
  .gallery-masthead-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(6,9,15,0.45) 0%, rgba(6,9,15,0.15) 40%, rgba(6,9,15,0.65) 100%);
  }
  .gallery-masthead-content {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    justify-content: flex-end;
    padding-bottom: clamp(16px, 4%, 36px);
    z-index: 10;
  }
  .gallery-masthead-content h1 {
    font-family: var(--font-serif); font-weight: 700;
    font-size: clamp(36px, 5.5vw, 72px); color: #ffffff; line-height: 1.05; margin-top: 8px;
  }
  .masthead-sub {
    font-size: 14px; font-weight: 400; color: rgba(221,213,196,0.75);
    margin-top: 6px; max-width: 520px;
  }

  /* ── FILTER BAR ── */
  .filter-bar {
    background: var(--navy-mid);
    border-bottom: 1px solid var(--gold-dim);
    position: sticky; top: 72px; z-index: 100;
  }
  .filter-inner { display: flex; flex-wrap: wrap; }
  .filter-btn {
    background: none; border: none; border-right: 1px solid var(--gold-dim);
    padding: 16px 24px; cursor: pointer;
    font-family: var(--font-sans); font-size: 10px;
    font-weight: 400; letter-spacing: 3px; text-transform: uppercase;
    color: rgba(221,213,196,0.45);
    transition: color .2s, background .2s;
  }
  .filter-btn:hover  { color: var(--gold); background: var(--gold-glow); }
  .filter-btn.active { color: var(--gold); border-bottom: 2px solid var(--gold); }

  /* ── GALLERY ── */
  .gallery-section { padding: var(--section-pad) 0; }

  .album-group { margin-bottom: 64px; }
  .album-group.hidden { display: none; }

  .album-header {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-bottom: 24px; padding-bottom: 16px;
    border-bottom: 1px solid var(--gold-dim);
  }
  .album-title {
    font-family: var(--font-serif); font-weight: 600;
    font-size: clamp(22px, 2.8vw, 36px); margin-top: 6px;
  }
  .album-count {
    font-size: 10px; letter-spacing: 3px; text-transform: uppercase;
    color: rgba(221,213,196,0.35);
  }

  /* Masonry-style grid using CSS columns */
  .photo-grid {
    columns: 3;
    column-gap: 6px;
  }
  @media (max-width: 900px) { .photo-grid { columns: 2; } }
  @media (max-width: 540px) { .photo-grid { columns: 1; } }

  .photo-cell {
    display: block; width: 100%;
    margin-bottom: 6px;
    position: relative; overflow: hidden;
    background: none; border: none; padding: 0;
    cursor: zoom-in;
    break-inside: avoid;
  }
  .photo-img {
    width: 100%; height: auto; display: block;
    filter: brightness(0.82) saturate(0.85);
    transition: filter .4s, transform .4s;
  }
  .photo-cell:hover .photo-img {
    filter: brightness(0.95) saturate(1);
    transform: scale(1.02);
  }

  .photo-hover {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(6,9,15,0.7) 0%, transparent 60%);
    opacity: 0; transition: opacity .35s;
    display: flex; flex-direction: column;
    justify-content: flex-end; align-items: flex-start;
    padding: 16px;
  }
  .photo-cell:hover .photo-hover { opacity: 1; }

  .photo-expand {
    position: absolute; top: 12px; right: 14px;
    font-size: 22px; color: var(--gold); opacity: 0.8;
  }
  .photo-caption-text {
    font-family: var(--font-serif); font-size: 14px; font-weight: 400;
    color: var(--cream); line-height: 1.3;
  }

  .gallery-note {
    margin-top: 40px; padding-top: 24px;
    border-top: 1px solid var(--gold-dim);
    font-size: 13px; font-weight: 400; color: rgba(221,213,196,0.45); line-height: 1.8;
  }
  .gallery-note a { color: var(--gold); text-decoration: none; }
  .gallery-note a:hover { text-decoration: underline; }

  /* ── LIGHTBOX ── */
  .lightbox {
    position: fixed; inset: 0; z-index: 1000;
    background: rgba(6,9,15,0.96);
    display: flex; align-items: center; justify-content: center;
  }
  .lightbox[hidden] { display: none; }

  .lb-stage {
    max-width: 90vw; max-height: 90vh;
    display: flex; flex-direction: column; align-items: center; gap: 14px;
  }
  .lb-img {
    max-width: 90vw; max-height: 80vh;
    object-fit: contain;
    border: 1px solid var(--gold-dim);
  }
  .lb-caption {
    font-family: var(--font-serif); font-size: 15px; font-weight: 400;
    color: rgba(221,213,196,0.7); text-align: center;
  }

  .lb-close, .lb-prev, .lb-next {
    position: fixed;
    background: rgba(6,9,15,0.7); border: 1px solid var(--gold-dim);
    color: var(--cream); cursor: pointer;
    transition: color .2s, background .2s;
  }
  .lb-close:hover, .lb-prev:hover, .lb-next:hover {
    color: var(--gold); background: var(--navy-mid);
  }
  .lb-close {
    top: 20px; right: 24px;
    font-size: 18px; padding: 8px 14px;
  }
  .lb-prev, .lb-next {
    top: 50%; transform: translateY(-50%);
    font-size: 32px; padding: 12px 18px; line-height: 1;
  }
  .lb-prev { left: 16px; }
  .lb-next { right: 16px; }

  /* ── CTA ── */
  .cta-banner {
    background: linear-gradient(135deg, var(--navy-light) 0%, var(--navy-mid) 100%);
    border-top: 1px solid var(--gold-dim);
    padding: 80px 0;
  }
  .cta-inner {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 36px;
  }
  .cta-inner h2 {
    font-family: var(--font-serif); font-weight: 600;
    font-size: clamp(24px, 3vw, 40px); margin-bottom: 12px;
  }
  .cta-inner p {
    font-size: 15px; font-weight: 400; color: rgba(221,213,196,0.78);
    max-width: 480px; line-height: 1.8;
  }
  .cta-buttons { display: flex; gap: 16px; flex-wrap: wrap; flex-shrink: 0; }
</style>

<script>
  // ── Album filter ──────────────────────────────────────────────
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const albumGroups = document.querySelectorAll<HTMLElement>('.album-group');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const target = btn.dataset.album!;
      albumGroups.forEach(g => {
        g.classList.toggle('hidden', target !== 'all' && g.dataset.album !== target);
      });
    });
  });

  // ── Lightbox ─────────────────────────────────────────────────
  const lightbox  = document.getElementById('lightbox')!;
  const lbImg     = document.getElementById('lb-img') as HTMLImageElement;
  const lbCaption = document.getElementById('lb-caption')!;
  const lbClose   = document.getElementById('lb-close')!;
  const lbPrev    = document.getElementById('lb-prev')!;
  const lbNext    = document.getElementById('lb-next')!;

  // Flat list of all photos across all visible albums
  let allCells: HTMLButtonElement[] = [];
  let currentIdx = 0;

  function openLightbox(cell: HTMLButtonElement) {
    allCells = Array.from(document.querySelectorAll<HTMLButtonElement>('.album-group:not(.hidden) .photo-cell'));
    currentIdx = allCells.indexOf(cell);
    showPhoto(currentIdx);
    lightbox.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    lbClose.focus();
  }

  function closeLightbox() {
    lightbox.setAttribute('hidden', '');
    document.body.style.overflow = '';
  }

  function showPhoto(idx: number) {
    const cell = allCells[idx];
    lbImg.src     = cell.dataset.src!;
    lbImg.alt     = cell.dataset.alt!;
    lbCaption.textContent = cell.dataset.caption!;
    lbPrev.style.display = allCells.length > 1 ? '' : 'none';
    lbNext.style.display = allCells.length > 1 ? '' : 'none';
  }

  document.querySelectorAll<HTMLButtonElement>('.photo-cell').forEach(cell => {
    cell.addEventListener('click', () => openLightbox(cell));
  });

  lbClose.addEventListener('click', closeLightbox);
  lbPrev.addEventListener('click', () => { currentIdx = (currentIdx - 1 + allCells.length) % allCells.length; showPhoto(currentIdx); });
  lbNext.addEventListener('click', () => { currentIdx = (currentIdx + 1) % allCells.length; showPhoto(currentIdx); });

  lightbox.addEventListener('click', e => { if (e.target === lightbox) closeLightbox(); });

  document.addEventListener('keydown', e => {
    if (lightbox.hasAttribute('hidden')) return;
    if (e.key === 'Escape')     closeLightbox();
    if (e.key === 'ArrowLeft')  { currentIdx = (currentIdx - 1 + allCells.length) % allCells.length; showPhoto(currentIdx); }
    if (e.key === 'ArrowRight') { currentIdx = (currentIdx + 1) % allCells.length; showPhoto(currentIdx); }
  });
</script>
