---
// src/pages/index.astro
// Homepage — pulls all content from TinaCMS-managed JSON/Markdown files.
// The owner edits text via the Tina admin UI; this file never needs to change.

import BaseLayout from '../layouts/BaseLayout.astro';
import Nav        from '../components/Nav.astro';
import Footer     from '../components/Footer.astro';

// In the real build, these imports come from Tina's generated client:
//   import { client } from '../tina/__generated__/client';
//   const home = await client.queries.homePage({ relativePath: 'index.json' });
// For the scaffold we use inline data that mirrors exactly what Tina serves.

const home = {
  heroHeadline:    'Life',
  heroAccent:      'Un',
  heroSubheadline: 'anchored.',
  heroBody:        'A full-service marina on Carlyle Lake — the largest man-made lake in Illinois and one of the best sailing lakes in the Midwest. Floating concrete docks, a real ship\'s store, and a tight-knit community that\'s been calling Boulder home since before you were rigged.',
  heroCta1:        'Reserve a Slip',
  heroCta2:        'View Services & Rates',
  aboutHeadline:   'Your dock on the northeastern shore of Carlyle Lake.',
  aboutBody: [
    'The damming of the Kaskaskia River created the largest man-made lake in Illinois. At normal pool, Carlyle Lake stretches 15 miles long by 3½ miles wide, covering 26,000 acres and offering a premier destination for recreation.',
    'Recognized as one of the nation\'s top-ten inland sailing lakes, Carlyle Lake hosts races and regattas throughout the season — and is equally welcoming to powerboaters, campers, anglers, and hunters.',
    'Boulder Access Marina provides a premier sailing venue and home for motorboats large and small. We have floating concrete docks for every size vessel, with water and shore power, a full-service yard, a comfortable clubhouse, bathhouse, Ship\'s Store, free WiFi, and a covered pavilion with the best sunset views on the lake.',
    'Long before the lake existed, the Kaskaskia — the Native American tribe that gave the river its name — were the dominant group in the region, drawn to the Boulder area by its sweeping vistas and fertile land.',
    'We\'re a privately owned marina, separate from Boulder Campground — home to landlocked boaters and serious sailors alike. No pretense. Just the lake.',
  ],
};

const bycSection = {
  headline: 'Boulder Yacht Club — Your home on the eastern shore.',
  body:     'BYC has been the only yacht club on the eastern shore of Carlyle Lake since 1983. Whether you race, cruise, paddle, or just show up for Tapas on the Docks — you belong here. Sailors, pontoon captains, kayakers, newcomers, and old salts alike.',
  events: [
    { title: 'Tapas on the Docks — Yacht Rock Theme', org: 'BYC',      type: 'Social'   },
    { title: 'BYC Midnight Regatta',                   org: 'BYC',      type: 'Racing'   },
    { title: 'Lethal Luau Party',                      org: 'BYC',      type: 'Social'   },
    { title: 'Renshaw Regatta',                        org: 'BYC',      type: 'Racing'   },
    { title: 'BYC Charity Event',                      org: 'BYC',      type: 'Charity'  },
    { title: 'Spero\'s Spaghetti Dinner',              org: 'BYC',      type: 'Social'   },
    { title: 'BYC Commodore\'s Cup',                   org: 'BYC',      type: 'Racing'   },
    { title: 'Halloween Party & Chili Cookoff',        org: 'BYC',      type: 'Social'   },
    { title: 'Fireworks Raft-Up',                      org: 'Both',     type: 'Social'   },
  ],
  board: [
    { role: 'Commodore',          name: 'Mark Swinburne' },
    { role: 'Vice-Commodore',     name: 'Phil Stephenson' },
    { role: 'Secretary/Treasurer',name: 'Pam McBride' },
    { role: 'Race Chair',         name: 'Kirk Hulse' },
    { role: 'Social Chair',       name: 'Mike Shelton' },
  ],
};

const stats = [
  { value: '26,000',  label: 'Acre Lake' },
  { value: '1983',    label: 'BYC Founded' },
  { value: '8',       label: 'Club Races / Season' },
  { value: '501(c)7', label: 'Nonprofit Club' },
];

const services = [
  { icon: '⚓', title: 'Slip Rentals',    detail: 'From $139.50/mo', desc: 'Floating concrete docks with water & electric. Seasonal contracts for 18–37 ft vessels.' },
  { icon: '🏗️', title: 'Lift-In / Out',  detail: '$200/ride',       desc: 'Scheduled haul-outs and launches. Book 1 week in advance. Labor rate $125/hr thereafter.' },
  { icon: '🎨', title: 'Bottom Paint',   detail: '$30/ft',           desc: 'Full bottom paint job including sanding, wash, and labor. Materials supplied.' },
  { icon: '🏠', title: 'Dry Storage',    detail: '$99/mo',           desc: 'Full season dry storage on site. Cradle, trailer, and jack stand storage available.' },
  { icon: '⛽', title: 'Gas Dock',       detail: 'On site',          desc: 'Fuel dock available on site for members and transient boaters.' },
  { icon: '🏪', title: "Ship's Store",   detail: 'Thu–Sun',          desc: 'Snacks, ice cream, hardware, oils, firewood, paddleboards, and treasure chests for kids.' },
];
---

<BaseLayout
  title="Boulder Marina | Carlyle Lake Marina Near St. Louis"
  description="Boat slips, marina services, storage, and lake access for sailboats, motorboats, pontoons, and cruisers on Carlyle Lake near St. Louis."
>
  <Nav />

  <!-- ── MASTHEAD ─────────────────────────────────────────────────── -->
  <section class="masthead">
    <div class="masthead-img-wrap">
      <img
        src="/uploads/marina-panorama.jpg"
        alt="Boulder Marina on Carlyle Lake, Illinois"
        width="1024" height="298"
        loading="eager"
        fetchpriority="high"
        class="masthead-img"
      />
      <div class="masthead-overlay" aria-hidden="true"></div>
    </div>

    <div class="masthead-content container">
      <p class="section-tag fade-up">Boulder Access Marina · Carlyle Lake, Illinois</p>
      <h1 class="masthead-heading fade-up delay-1">
        Life <span class="hero-accent">Un</span><em class="hero-italic">anchored.</em>
      </h1>
      <div class="masthead-ctas fade-up delay-2">
        <a href="/contact#slip-reservation" class="btn btn--fill">{home.heroCta1}</a>
        <a href="/services"                 class="btn"          >{home.heroCta2}</a>
      </div>
    </div>
  </section>

  <!-- ── ABOUT BAND ─────────────────────────────────────────────── -->
  <section class="section about-band" aria-labelledby="about-heading">
    <div class="container about-grid">
      <div class="about-text">
        <p class="section-tag">Full-Service Marina</p>
        <h2 id="about-heading">{home.aboutHeadline}</h2>
        {home.aboutBody.map(para => <p>{para}</p>)}
        <a href="/about" class="btn">About the Marina</a>
      </div>
      <div class="about-visual">
        <div class="about-img-wrap">
          <img
            src="/uploads/marina-hero.jpg"
            alt="Boulder Marina floating docks on Carlyle Lake"
            width="1600" height="550"
            loading="lazy"
          />
          <div class="about-img-badge">
            <span class="badge-label">Carlyle Lake</span>
            <span class="badge-val">26,000 acres</span>
          </div>
        </div>
        <div class="amenity-pills">
          {['Floating concrete docks','Water & electric','Heated clubhouse','Free WiFi & satellite TV',
            'Heated bathhouse','Sunset pavilion','Private boat ramp','Gas dock','Ship\'s store','Boulder Yacht Club'].map(a => (
            <span class="amenity-pill">{a}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── SERVICES ───────────────────────────────────────────────── -->
  <section class="section services-section" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="section-tag">What We Offer</p>
          <h2 id="services-heading">Everything your boat needs — and then some.</h2>
        </div>
        <a href="/services" class="btn">Full Rate Sheet</a>
      </div>
      <div class="services-grid">
        {services.map(s => (
          <article class="svc-card">
            <span class="svc-icon" aria-hidden="true">{s.icon}</span>
            <div class="svc-title-row">
              <h3>{s.title}</h3>
              <span class="svc-price">{s.detail}</span>
            </div>
            <p>{s.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── BYC CROSS-PROMO ────────────────────────────────────────── -->
  <section class="section byc-section" aria-labelledby="byc-heading">
    <div class="container byc-grid">

      <!-- Left: BYC identity -->
      <div class="byc-text">
        <p class="section-tag">Est. 1983 · 501(c)(7) Nonprofit</p>
        <h2 id="byc-heading">{bycSection.headline}</h2>
        <p>{bycSection.body}</p>

        <!-- 2026 Board -->
        <div class="board-block" aria-label="2026 BYC Officers">
          <p class="section-tag" style="margin-top:32px">2026 Officers</p>
          <dl class="board-list">
            {bycSection.board.map(o => (
              <>
                <dt>{o.role}</dt>
                <dd>{o.name}</dd>
              </>
            ))}
          </dl>
        </div>

        <div class="byc-ctas">
          <a href="/boulder-yacht-club" class="btn btn--fill">Explore BYC</a>
          <a href="/boulder-yacht-club#membership" class="btn">Join the Club</a>
        </div>
      </div>

      <!-- Right: BYC events grid -->
      <div class="byc-events">
        <p class="section-tag">Season Highlights</p>
        <ul class="byc-event-list" role="list">
          {bycSection.events.map(e => (
            <li class="byc-event-row">
              <div class="byc-event-org" data-org={e.org}>
                {e.org === 'Both' ? 'Marina + BYC' : e.org}
              </div>
              <span class="byc-event-name">{e.title}</span>
              <span class="byc-event-type">{e.type}</span>
            </li>
          ))}
        </ul>
        <p class="byc-event-note">
          All sailors, cruisers, motor boaters, kayakers, and paddleboarders welcome.
          Come crew in a race before you buy a boat.
        </p>
      </div>
    </div>
  </section>

  <!-- ── STATS BAND ─────────────────────────────────────────────── -->
  <section class="stats-band" aria-label="Key facts">
    <div class="container stats-grid">
      {stats.map(s => (
        <div class="stat-item">
          <span class="stat-val">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ── GALLERY STRIP ──────────────────────────────────────────── -->
  <section class="section gallery-strip" aria-labelledby="gallery-heading">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="section-tag">On-Site</p>
          <h2 id="gallery-heading">Ship's Store & Marina Life</h2>
        </div>
        <a href="/gallery" class="btn">Full Gallery</a>
      </div>
      <div class="gallery-mosaic">
        <div class="gallery-cell gallery-cell--wide">
          <img
            src="/uploads/marina-hero.jpg"
            alt="Boulder Marina panorama from the lake"
            loading="lazy"
          />
          <div class="gallery-caption">Boulder Marina · Carlyle Lake, IL</div>
        </div>
        <div class="gallery-cell">
          <img src="https://bouldermarina.com/wp-content/uploads/2021/07/20210724_113454-1024x768.jpg" alt="Ship's Store interior" loading="lazy" />
        </div>
        <div class="gallery-cell gallery-cell--hours">
          <p class="section-tag">Store Hours</p>
          <div class="hours-list">
            <span>Thu – Fri</span><span>11:00 – 6:00</span>
            <span>Saturday</span><span>9:00 – 5:00</span>
            <span>Sunday</span><span>9:00 – 3:30</span>
            <span>Holidays</span><span>9:00 – 3:30</span>
          </div>
          <p class="store-note">Ice cream · Snacks · Hardware · Paddleboards · Kids' treasure chests</p>
        </div>
        <div class="gallery-cell">
          <img src="https://bouldermarina.com/wp-content/uploads/2021/07/20210724_113415-1024x768.jpg" alt="Marina dock view" loading="lazy" />
        </div>
        <div class="gallery-cell">
          <img src="https://bouldermarina.com/wp-content/uploads/2021/07/20210306_105450-768x1024.jpg" alt="Store merchandise" loading="lazy" style="object-position:top" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA BANNER ─────────────────────────────────────────────── -->
  <section class="cta-banner" aria-label="Reserve a slip">
    <div class="container cta-inner">
      <div>
        <p class="section-tag">2026 Season</p>
        <h2>Ready to dock with us?</h2>
        <p>Slip rates start at $139.50/mo for 18 ft vessels. Day use available at $25 flat. Come see what life on Carlyle Lake looks like.</p>
      </div>
      <div class="cta-buttons">
        <a href="/contact#slip-reservation" class="btn btn--fill">Reserve a Slip</a>
        <a href="/services"                  class="btn"          >View All Rates</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* ── HERO ── */
  .hero {
    position: relative;
    height: 100vh;
    min-height: 640px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  /* ── MASTHEAD ── */
  .masthead {
    position: relative;
    width: 100%;
    margin-top: 0; /* nav is fixed, so no offset needed */
  }

  .masthead-img-wrap {
    position: relative;
    width: 100%;
    line-height: 0;
  }
  .masthead-img {
    width: 100%;
    height: auto;
    display: block;
    filter: brightness(0.9) saturate(0.85);
  }
  .masthead-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(6,9,15,0.45) 0%,
      rgba(6,9,15,0.15) 40%,
      rgba(6,9,15,0.65) 100%
    );
  }

  .masthead-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: clamp(16px, 4%, 36px);
    z-index: 10;
  }

  .masthead-heading {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(36px, 6vw, 80px);
    color: #ffffff;
    line-height: 1;
    letter-spacing: -1px;
    margin: 8px 0 14px;
  }
  .hero-accent { color: var(--gold); font-weight: 300; }
  .hero-italic { font-style: italic; font-weight: 400; color: rgba(221,213,196,0.7); }

  .masthead-ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  /* ── ABOUT ── */
  .section { padding: var(--section-pad) 0; }
  .about-band { background: var(--navy-mid); border-top: 1px solid var(--gold-dim); border-bottom: 1px solid var(--gold-dim); }

  .about-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center;
  }
  .about-text h2 {
    font-family: var(--font-serif); font-weight: 600;
    font-size: clamp(26px, 3.2vw, 44px); line-height: 1.15; margin-bottom: 20px;
  }
  .about-text p {
    font-size: 15px; font-weight: 400; line-height: 1.85;
    color: rgba(221,213,196,0.82); margin-bottom: 16px;
  }
  .about-text .btn { margin-top: 12px; }

  .about-img-wrap { position: relative; margin-bottom: 20px; }
  .about-img-wrap img { width: 100%; display: block; filter: brightness(0.82) saturate(0.8); }
  .about-img-badge {
    position: absolute; top: 14px; right: 14px;
    background: rgba(6,9,15,0.88); backdrop-filter: blur(8px);
    border: 1px solid var(--gold-dim); padding: 10px 16px;
  }
  .badge-label { display: block; font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); }
  .badge-val   { display: block; font-family: var(--font-serif); font-weight: 600; font-size: 18px; margin-top: 2px; }

  .amenity-pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .amenity-pill {
    font-size: 13px; font-weight: 600; padding: 8px 14px;
    border: 1px solid rgba(196,154,42,0.4); color: var(--cream);
    transition: border-color .25s, color .25s;
  }
  .amenity-pill:hover { border-color: var(--gold); color: #fff; }

  /* ── SERVICES ── */
  .section-header {
    display: flex; justify-content: space-between; align-items: flex-end;
    flex-wrap: wrap; gap: 20px; margin-bottom: 48px;
  }
  .section-header h2 {
    font-family: var(--font-serif); font-weight: 600;
    font-size: clamp(26px, 3vw, 44px); line-height: 1.1; max-width: 460px;
  }

  .services-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: var(--gold-glow);
  }
  .svc-card {
    padding: 36px 28px; background: rgba(255,255,255,0.02);
    border: 1px solid var(--gold-dim);
    transition: background .35s, border-color .35s, transform .35s;
    position: relative; overflow: hidden;
  }
  .svc-card::after {
    content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px;
    background: var(--gold); transform: scaleX(0); transition: transform .35s;
  }
  .svc-card:hover { background: var(--gold-glow); border-color: rgba(196,154,42,0.35); transform: translateY(-3px); }
  .svc-card:hover::after { transform: scaleX(1); }
  .svc-icon { font-size: 26px; display: block; margin-bottom: 14px; }
  .svc-title-row {
    display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px;
  }
  .svc-title-row h3 { font-family: var(--font-serif); font-weight: 600; font-size: 21px; }
  .svc-price { font-size: 11px; color: var(--gold); font-weight: 400; }
  .svc-card p { font-size: 14px; font-weight: 400; line-height: 1.85; color: rgba(221,213,196,0.78); }

  /* ── BYC ── */
  .byc-section {
    background: var(--navy-mid);
    border-top: 1px solid var(--gold-dim);
    border-bottom: 1px solid var(--gold-dim);
  }
  .byc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: start; }
  .byc-text h2 {
    font-family: var(--font-serif); font-weight: 600; font-style: italic;
    font-size: clamp(24px, 3vw, 42px); line-height: 1.15; margin-bottom: 20px;
  }
  .byc-text p { font-size: 15px; font-weight: 400; line-height: 1.85; color: rgba(221,213,196,0.82); margin-bottom: 14px; }

  .board-list {
    display: grid; grid-template-columns: 1fr 1fr; gap: 4px 16px;
    font-size: 12px; font-weight: 300;
  }
  .board-list dt { color: rgba(221,213,196,0.4); }
  .board-list dd { color: var(--cream); }

  .byc-ctas { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 28px; }

  .byc-event-list { list-style: none; }
  .byc-event-row {
    display: flex; align-items: center; gap: 14px; padding: 14px 0;
    border-bottom: 1px solid rgba(196,154,42,0.1);
    transition: padding-left .25s;
    cursor: pointer;
  }
  .byc-event-row:hover { padding-left: 10px; }
  .byc-event-org {
    font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
    padding: 3px 8px; border: 1px solid var(--gold-dim); color: var(--gold);
    min-width: 72px; text-align: center;
  }
  .byc-event-org[data-org="Both"] { border-color: rgba(196,154,42,0.4); background: var(--gold-glow); }
  .byc-event-name { font-family: var(--font-serif); font-weight: 600; font-size: 18px; flex: 1; }
  .byc-event-type { font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: rgba(221,213,196,0.35); }
  .byc-event-note { font-size: 11px; font-weight: 300; color: rgba(221,213,196,0.3); margin-top: 20px; line-height: 1.7; }

  /* ── STATS ── */
  .stats-band {
    background: var(--navy);
    border-top: 1px solid var(--gold-dim);
    border-bottom: 1px solid var(--gold-dim);
    padding: 48px 0;
  }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .stat-item { text-align: center; }
  .stat-val {
    display: block; font-family: var(--font-serif); font-weight: 900;
    font-size: clamp(32px, 5vw, 52px); color: var(--gold); line-height: 1;
  }
  .stat-label {
    display: block; font-size: 10px; letter-spacing: 4px; text-transform: uppercase;
    color: rgba(221,213,196,0.78); margin-top: 8px;
  }

  /* ── GALLERY ── */
  .gallery-mosaic {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 240px 240px;
    gap: 3px;
  }
  .gallery-cell { position: relative; overflow: hidden; }
  .gallery-cell img {
    width: 100%; height: 100%; object-fit: cover;
    filter: brightness(0.78) saturate(0.8);
    transition: transform .5s var(--ease), filter .5s var(--ease);
  }
  .gallery-cell:hover img { transform: scale(1.05); filter: brightness(0.82) saturate(1); }
  .gallery-cell--wide { grid-row: 1 / 3; }
  .gallery-caption {
    position: absolute; bottom: 16px; left: 18px;
    font-family: var(--font-serif); font-weight: 600; font-size: 18px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.8);
  }
  .gallery-cell--hours {
    background: var(--gold-glow); border: 1px solid var(--gold-dim);
    padding: 28px 24px; display: flex; flex-direction: column; justify-content: center;
  }
  .hours-list {
    display: grid; grid-template-columns: 1fr 1fr; gap: 4px 12px; margin-bottom: 14px;
    font-size: 11px;
  }
  .hours-list span:nth-child(odd)  { color: rgba(221,213,196,0.45); font-weight: 300; }
  .hours-list span:nth-child(even) { color: var(--gold); font-weight: 400; }
  .store-note { font-size: 10px; font-weight: 300; color: rgba(221,213,196,0.3); line-height: 1.7; }

  /* ── CTA BANNER ── */
  .cta-banner {
    background: linear-gradient(135deg, var(--navy-light) 0%, var(--navy-mid) 100%);
    border-top: 1px solid var(--gold-dim);
    padding: 80px 0;
  }
  .cta-inner {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 36px;
  }
  .cta-inner h2 {
    font-family: var(--font-serif); font-weight: 600;
    font-size: clamp(24px, 3vw, 42px); margin-bottom: 12px;
  }
  .cta-inner p { font-size: 15px; font-weight: 400; color: rgba(221,213,196,0.78); max-width: 480px; line-height: 1.8; }
  .cta-buttons { display: flex; gap: 16px; flex-wrap: wrap; flex-shrink: 0; }

  /* ── RESPONSIVE ── */
  @media (max-width: 960px) {
    .about-grid, .byc-grid { grid-template-columns: 1fr; gap: 40px; }
    .services-grid { grid-template-columns: 1fr 1fr; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .gallery-mosaic { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .gallery-cell--wide { grid-row: auto; }
  }
  @media (max-width: 600px) {
    .services-grid { grid-template-columns: 1fr; }
    .gallery-mosaic { grid-template-columns: 1fr; }
    .hero-pills { gap: 24px; }
  }
