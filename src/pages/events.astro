---
// src/pages/events.astro
// 2026 season events pulled from boulderyc.org/wp-json/tribe/events/v1/events
// Update each season with fresh data from the BYC API.

import BaseLayout from '../layouts/BaseLayout.astro';
import Nav        from '../components/Nav.astro';
import Footer     from '../components/Footer.astro';

const events = [
  {
    date: '2026-03-13', month: 'March', day: 'Friday',
    time: '5:00 – 10:00 PM',
    title: '2026 No Boat Regatta',
    org: 'BYC', category: 'Social',
    description: 'Kick off the season before the boats hit the water — a BYC tradition of sailing stories, tall tales, and camaraderie. No boat required.',
    lakewide: false,
  },
  {
    date: '2026-05-16', month: 'May', day: 'Saturday',
    time: '6:00 PM',
    title: "Spero's Spaghetti Dinner",
    org: 'BYC', category: 'Social',
    description: "A beloved BYC tradition. Come for the pasta, stay for the company. One of the most anticipated social nights of the early season.",
    lakewide: false,
  },
  {
    date: '2026-05-30', month: 'May', day: 'Saturday',
    time: '12:00 – 4:00 PM',
    title: "TYC Commodore's Cup",
    org: 'Lakewide', category: 'Racing',
    description: "Tradewinds Yacht Club–hosted lakewide racing event. Open to all Carlyle Lake sailors. See Notice of Race for full details.",
    lakewide: true,
  },
  {
    date: '2026-06-06', month: 'June', day: 'Saturday',
    time: '12:00 – 4:00 PM',
    title: "Cruiser's Cup #1",
    org: 'Lakewide', category: 'Racing',
    description: "TYC-sponsored lakewide cruiser race. First of two Cruiser's Cup events this season. Open to all Carlyle Lake sailors.",
    lakewide: true,
  },
  {
    date: '2026-06-13', month: 'June', day: 'Saturday',
    time: '5:00 – 10:00 PM',
    title: 'BYC Lethal Luau Party',
    org: 'BYC', category: 'Social',
    description: "Slip into something tropical and join BYC for one of the summer's liveliest nights. Tiki drinks, great music, and the best lakeside atmosphere on the eastern shore.",
    lakewide: false,
  },
  {
    date: '2026-06-27', month: 'June', day: 'Saturday',
    time: 'All Day',
    title: 'Fireworks Raft-Up',
    org: 'Lakewide', category: 'Social',
    description: "A Carlyle Lake tradition — tie up with friends and watch the fireworks light up the sky over the water. One of the most memorable nights of the season.",
    lakewide: true,
  },
  {
    date: '2026-07-11', month: 'July', day: 'Saturday',
    time: '5:00 – 9:00 PM',
    title: 'BYC Tapas on the Docks — Yacht Rock Theme',
    org: 'BYC', category: 'Social',
    description: "BYC's signature summer social, this year with a Yacht Rock theme. Small plates, smooth grooves, and the best seats on the lake. Don't miss it.",
    lakewide: false,
  },
  {
    date: '2026-07-18', month: 'July', day: 'Saturday',
    time: '12:00 – 4:00 PM',
    title: 'CYC Home Port Race',
    org: 'Lakewide', category: 'Racing',
    description: 'CYC-hosted lakewide racing event. Open to all Carlyle Lake sailors.',
    lakewide: true,
  },
  {
    date: '2026-07-25', month: 'July', day: 'Saturday',
    time: '8:00 – 11:30 PM',
    title: 'Lighted Boat Parade',
    org: 'Lakewide', category: 'Social',
    description: "Deck your boat in lights and join the parade across Carlyle Lake after dark. A crowd favorite for families and a spectacular sight from the docks.",
    lakewide: true,
  },
  {
    date: '2026-08-01', month: 'August', day: 'Saturday',
    time: '8:00 – 11:30 PM',
    title: 'CYC Moonlight Regatta',
    org: 'Lakewide', category: 'Racing',
    description: "Race under the stars on Carlyle Lake — a lakewide tradition and one of the most beloved events of the sailing season.",
    lakewide: true,
  },
  {
    date: '2026-08-08', month: 'August', day: 'Saturday',
    time: '1:00 – 7:00 PM',
    title: 'BYC Pain Killer Raft Up',
    org: 'BYC', category: 'Social',
    description: "Tie up, float together, and enjoy a long summer afternoon on the water with your BYC family. Bring drinks, snacks, and good spirits.",
    lakewide: false,
  },
  {
    date: '2026-08-15', month: 'August', day: 'Saturday',
    time: '12:30 – 4:00 PM',
    title: 'Renshaw Regatta',
    org: 'BYC', category: 'Racing',
    description: "BYC's premier lakewide regatta — one of the most competitive and celebrated races on Carlyle Lake each season. See Notice of Race for full details.",
    lakewide: false,
  },
  {
    date: '2026-08-29', month: 'August', day: 'Saturday',
    time: 'All Day',
    title: 'CSA Whale of a Sail',
    org: 'Lakewide', category: 'Racing',
    description: "Two-day lakewide sailing event hosted by the Carlyle Sailing Association (Aug 29–30). Open to all Carlyle Lake sailors.",
    lakewide: true,
  },
  {
    date: '2026-08-29', month: 'August', day: 'Saturday',
    time: '8:30 – 11:00 PM',
    title: 'BYC Midnight Regatta',
    org: 'BYC', category: 'Racing',
    description: "Race into the night on Carlyle Lake. BYC's nocturnal race is a thrilling test of seamanship and navigation — and an experience you won't forget.",
    lakewide: false,
  },
  {
    date: '2026-09-19', month: 'September', day: 'Saturday',
    time: 'All Day',
    title: 'BYC Charity Event',
    org: 'BYC', category: 'Charity',
    description: "BYC's annual charity fundraiser benefiting local causes including Backstoppers, Hannah's Playground, Got Your Six, and Miracles in Progress.",
    lakewide: false,
  },
  {
    date: '2026-09-26', month: 'September', day: 'Saturday',
    time: '12:00 PM – 9:00 PM',
    title: "Cruiser's Cup #2 & Chili Cookoff",
    org: 'Lakewide', category: 'Racing',
    description: "Second lakewide Cruiser's Cup of the season followed by BYC's legendary Chili Cookoff. Race in the afternoon, stir the pot in the evening.",
    lakewide: true,
  },
  {
    date: '2026-10-03', month: 'October', day: 'Saturday',
    time: '12:00 – 4:00 PM',
    title: "BYC Commodore's Cup",
    org: 'BYC', category: 'Racing',
    description: "BYC's season finale race. A prestigious close to the 2026 racing season — all BYC sailors are welcome.",
    lakewide: false,
  },
  {
    date: '2026-10-17', month: 'October', day: 'Saturday',
    time: '4:00 – 10:00 PM',
    title: 'BYC Halloween Party & Chili Cookoff',
    org: 'BYC', category: 'Social',
    description: "Costumes encouraged, chili required. BYC's Halloween Party is one of the most spirited nights of the off-season social calendar — come ready to compete.",
    lakewide: false,
  },
  {
    date: '2026-10-24', month: 'October', day: 'Saturday',
    time: '12:00 – 4:00 PM',
    title: 'The Great Race',
    org: 'Lakewide', category: 'Racing',
    description: "CYC-sponsored lakewide season-closing race. A fitting finale to a full season on Carlyle Lake. Open to all lake sailors.",
    lakewide: true,
  },
  {
    date: '2026-11-07', month: 'November', day: 'Saturday',
    time: '5:00 – 11:00 PM',
    title: 'Boulder Community Thanksgiving Dinner',
    org: 'BYC', category: 'Social',
    description: "The BYC community gathers to give thanks. A warm, welcoming celebration to close out the active season — all marina and club members welcome.",
    lakewide: false,
  },
  {
    date: '2026-12-05', month: 'December', day: 'Saturday',
    time: '12:00 – 4:00 PM',
    title: 'BYC Holiday Luncheon',
    org: 'BYC', category: 'Social',
    description: "Celebrate the season with BYC at the annual holiday luncheon. A festive close to 2026 — members and guests welcome.",
    lakewide: false,
  },
];

// Group by month
const byMonth: Record<string, typeof events> = {};
for (const e of events) {
  if (!byMonth[e.month]) byMonth[e.month] = [];
  byMonth[e.month].push(e);
}

const months = Object.keys(byMonth);

function dayNum(date: string) {
  return parseInt(date.split('-')[2], 10);
}
---

<BaseLayout
  title="2026 Events | Boulder Marina & Boulder Yacht Club on Carlyle Lake"
  description="2026 season calendar for Boulder Marina and Boulder Yacht Club — races, regattas, social nights, and lakewide events on Carlyle Lake near St. Louis."
>
  <Nav />

  <main>

    <!-- ── MASTHEAD ── -->
    <div class="events-masthead">
      <img
        src="/uploads/marina-panorama.jpg"
        alt="Boulder Marina on Carlyle Lake"
        width="1024" height="298"
        loading="eager"
        fetchpriority="high"
        class="events-masthead-img"
      />
      <div class="events-masthead-overlay" aria-hidden="true"></div>
      <div class="events-masthead-content container">
        <p class="section-tag">2026 Season</p>
        <h1>Events Calendar</h1>
        <p class="masthead-sub">Racing, regattas, social nights, and lakewide events — Boulder Marina & BYC.</p>
      </div>
    </div>

    <!-- ── FILTER BAR ── -->
    <div class="filter-bar" role="navigation" aria-label="Filter events">
      <div class="container filter-inner">
        <button class="filter-btn active" data-filter="all">All Events</button>
        <button class="filter-btn" data-filter="Racing">Racing</button>
        <button class="filter-btn" data-filter="Social">Social</button>
        <button class="filter-btn" data-filter="Marina">Marina</button>
        <button class="filter-btn" data-filter="Charity">Charity</button>
        <button class="filter-btn" data-filter="lakewide">Lakewide</button>
      </div>
    </div>

    <!-- ── EVENT LISTING ── -->
    <section class="events-section" aria-label="Season calendar">
      <div class="container">

        {months.map(month => (
          <div class="month-group">
            <h2 class="month-heading">
              <span class="month-rule" aria-hidden="true"></span>
              {month}
              <span class="month-rule" aria-hidden="true"></span>
            </h2>

            <div class="event-list">
              {byMonth[month].map(e => (
                <article
                  class="event-card"
                  data-category={e.category}
                  data-lakewide={e.lakewide ? 'true' : 'false'}
                >
                  <!-- Date block -->
                  <div class="event-date-block">
                    <span class="event-month-abbr">{e.month.slice(0,3).toUpperCase()}</span>
                    <span class="event-day-num">{dayNum(e.date)}</span>
                    <span class="event-weekday">{e.day.slice(0,3)}</span>
                  </div>

                  <!-- Content -->
                  <div class="event-body">
                    <div class="event-meta">
                      <span class={`event-org-badge org-${e.org.toLowerCase()}`}>
                        {e.org === 'BYC' ? '⛵ BYC' : e.org === 'Marina' ? '⚓ Marina' : '🌊 Lakewide'}
                      </span>
                      <span class="event-cat-tag">{e.category}</span>
                      {e.lakewide && <span class="event-lakewide-tag">Lakewide</span>}
                    </div>
                    <h3 class="event-title">{e.title}</h3>
                    <p class="event-time">🕐 {e.time}</p>
                    <p class="event-desc">{e.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}

        <p class="season-note">
          Calendar sourced from <a href="https://boulderyc.org/events/list/" target="_blank" rel="noopener">boulderyc.org</a>.
          Dates and details subject to change — follow the
          <a href="https://www.facebook.com/groups/320371721353276" target="_blank" rel="noopener">BYC Facebook group</a> for the latest.
        </p>

      </div>
    </section>

    <!-- ── CTA ── -->
    <section class="cta-banner">
      <div class="container cta-inner">
        <div>
          <p class="section-tag">Join the Community</p>
          <h2>Want to race or join BYC?</h2>
          <p>Boulder Yacht Club welcomes sailors, racers, and anyone who loves the water. No experience required — come crew in a race before you buy a boat.</p>
        </div>
        <div class="cta-buttons">
          <a href="/boulder-yacht-club#membership" class="btn btn--fill">Join BYC</a>
          <a href="/contact" class="btn">Contact the Marina</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* ── MASTHEAD ── */
  .events-masthead { position: relative; width: 100%; line-height: 0; }
  .events-masthead-img {
    width: 100%; height: auto; display: block;
    filter: brightness(0.9) saturate(0.85);
  }
  .events-masthead-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(6,9,15,0.45) 0%, rgba(6,9,15,0.15) 40%, rgba(6,9,15,0.65) 100%);
  }
  .events-masthead-content {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    justify-content: flex-end;
    padding-bottom: clamp(16px, 4%, 36px);
    z-index: 10;
  }
  .events-masthead-content h1 {
    font-family: var(--font-serif); font-weight: 700;
    font-size: clamp(36px, 5.5vw, 72px); color: #ffffff; line-height: 1.05; margin-top: 8px;
  }
  .masthead-sub {
    font-size: 14px; font-weight: 400; color: rgba(221,213,196,0.75);
    margin-top: 6px; max-width: 520px;
  }

  /* ── FILTER BAR ── */
  .filter-bar {
    background: var(--navy-mid);
    border-bottom: 1px solid var(--gold-dim);
    padding: 0;
    position: sticky; top: 72px; z-index: 100;
  }
  .filter-inner {
    display: flex; gap: 0; flex-wrap: wrap;
  }
  .filter-btn {
    background: none; border: none; border-right: 1px solid var(--gold-dim);
    padding: 16px 24px; cursor: pointer;
    font-family: var(--font-sans); font-size: 10px;
    font-weight: 400; letter-spacing: 3px; text-transform: uppercase;
    color: rgba(221,213,196,0.45);
    transition: color .2s, background .2s;
  }
  .filter-btn:hover { color: var(--gold); background: var(--gold-glow); }
  .filter-btn.active { color: var(--gold); border-bottom: 2px solid var(--gold); }

  /* ── EVENTS SECTION ── */
  .events-section { padding: var(--section-pad) 0; }

  .month-group { margin-bottom: 56px; }

  .month-heading {
    font-family: var(--font-sans); font-weight: 300;
    font-size: 10px; letter-spacing: 6px; text-transform: uppercase;
    color: var(--gold); display: flex; align-items: center; gap: 20px;
    margin-bottom: 28px;
  }
  .month-rule {
    flex: 1; height: 1px;
    background: linear-gradient(to right, transparent, var(--gold-dim));
  }
  .month-rule:first-child {
    background: linear-gradient(to left, transparent, var(--gold-dim));
  }

  .event-list { display: flex; flex-direction: column; gap: 2px; }

  .event-card {
    display: grid; grid-template-columns: 80px 1fr;
    gap: 0;
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--gold-dim);
    transition: background .25s, border-color .25s;
  }
  .event-card:hover {
    background: var(--gold-glow);
    border-color: rgba(196,154,42,0.35);
  }

  /* Date block */
  .event-date-block {
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 20px 12px;
    border-right: 1px solid var(--gold-dim);
    gap: 2px;
    background: rgba(196,154,42,0.04);
  }
  .event-month-abbr {
    font-size: 8px; letter-spacing: 3px; color: var(--gold); font-weight: 500;
  }
  .event-day-num {
    font-family: var(--font-serif); font-weight: 700;
    font-size: 28px; color: var(--cream); line-height: 1;
  }
  .event-weekday {
    font-size: 8px; letter-spacing: 2px; text-transform: uppercase;
    color: rgba(221,213,196,0.35);
  }

  /* Body */
  .event-body { padding: 20px 24px; }
  .event-meta {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .event-org-badge {
    font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
    padding: 3px 8px; border: 1px solid var(--gold-dim); color: var(--gold);
  }
  .event-org-badge.org-marina  { border-color: rgba(196,154,42,0.5); }
  .event-org-badge.org-lakewide { border-color: rgba(100,160,220,0.4); color: rgba(140,190,240,0.9); }

  .event-cat-tag {
    font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
    color: rgba(221,213,196,0.4);
  }
  .event-lakewide-tag {
    font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
    color: rgba(140,190,240,0.7);
    padding: 2px 6px; border: 1px solid rgba(100,160,220,0.25);
  }

  .event-title {
    font-family: var(--font-serif); font-weight: 600;
    font-size: clamp(17px, 2vw, 22px); margin-bottom: 6px; line-height: 1.2;
  }
  .event-time {
    font-size: 11px; font-weight: 400; color: var(--gold);
    letter-spacing: 1px; margin-bottom: 8px;
  }
  .event-desc {
    font-size: 14px; font-weight: 400; line-height: 1.75;
    color: rgba(221,213,196,0.75);
  }

  /* hidden by filter */
  .event-card.hidden { display: none; }

  .month-group.all-hidden { display: none; }

  .season-note {
    margin-top: 48px; padding-top: 28px;
    border-top: 1px solid var(--gold-dim);
    font-size: 12px; font-weight: 400; color: rgba(221,213,196,0.4);
    line-height: 1.8;
  }
  .season-note a { color: var(--gold); text-decoration: none; }
  .season-note a:hover { text-decoration: underline; }

  /* ── CTA BANNER ── */
  .cta-banner {
    background: linear-gradient(135deg, var(--navy-light) 0%, var(--navy-mid) 100%);
    border-top: 1px solid var(--gold-dim);
    padding: 80px 0;
  }
  .cta-inner {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 36px;
  }
  .cta-inner h2 {
    font-family: var(--font-serif); font-weight: 600;
    font-size: clamp(24px, 3vw, 40px); margin-bottom: 12px;
  }
  .cta-inner p {
    font-size: 15px; font-weight: 400; color: rgba(221,213,196,0.78);
    max-width: 480px; line-height: 1.8;
  }
  .cta-buttons { display: flex; gap: 16px; flex-wrap: wrap; flex-shrink: 0; }

  /* ── RESPONSIVE ── */
  @media (max-width: 600px) {
    .event-card { grid-template-columns: 64px 1fr; }
    .event-day-num { font-size: 22px; }
    .filter-btn { padding: 14px 16px; font-size: 9px; }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards   = document.querySelectorAll<HTMLElement>('.event-card');
  const groups  = document.querySelectorAll<HTMLElement>('.month-group');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.dataset.filter!;

      cards.forEach(card => {
        const cat      = card.dataset.category!;
        const lakewide = card.dataset.lakewide === 'true';
        const show =
          filter === 'all' ||
          (filter === 'lakewide' && lakewide) ||
          cat === filter;
        card.classList.toggle('hidden', !show);
      });

      // Hide month headers when all their cards are hidden
      groups.forEach(group => {
        const visible = group.querySelectorAll('.event-card:not(.hidden)').length > 0;
        group.classList.toggle('all-hidden', !visible);
      });
    });
  });
</script>
